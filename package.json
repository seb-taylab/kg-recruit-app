    "libphonenumber-js": "^1.13.1",
    "lucide-react": "^0.469.0",
    "next": "16.2.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.75.0",
    "react-signature-canvas": "^1.0.7",
