{
  "name": "kg-recruit-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:tokens": "style-dictionary build --config style-dictionary.config.mjs",
    "predev": "npm run build:tokens",
    "prebuild": "npm run build:tokens",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "validate-tokens": "tsx scripts/validate-tokens.ts",
    "validate-form-coordinates": "tsx scripts/validate-form-coordinates.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx,json}\""
  },
