{
  "$schema": "https://design-tokens.github.io/community-group/format/",

  "_meta": {
    "version": "1.1.0",
    "released": "2026-05-13",
    "owner": "Sebastian Tay",
    "brand": "PAP — Kampong Glam Branch"
  },

  "color": {
    "brand": {
      "red": {
        "$value": "#EF3340",
        "$type": "color",
        "$description": "PAP red (Pantone 032 approx.). Symbol of action. CTAs, focus rings, primary buttons. Approximate — confirm exact PAP red with HQ before public-facing launch."
      },
      "blue": {
        "$value": "#0052A1",
        "$type": "color",
        "$description": "PAP blue. Symbol of unity of all races. Secondary CTAs, links, navigation indicators."
      },
      "white": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "PAP white. Symbol of purity + integrity. Dominant surface — card backgrounds, dialog surfaces."
      }
    },
    "neutral": {
      "0":   { "$value": "#FFFFFF", "$type": "color", "$description": "Pure white. Card surfaces, dialog backgrounds." },
      "50":  { "$value": "#FAFAFA", "$type": "color", "$description": "Page background light grey." },
      "100": { "$value": "#F4F4F5", "$type": "color", "$description": "Subtle row stripes, hover backgrounds." },
      "200": { "$value": "#E4E4E7", "$type": "color", "$description": "Borders, dividers, disabled fills." },
      "400": { "$value": "#A1A1AA", "$type": "color", "$description": "Placeholder text, disabled text." },
      "500": { "$value": "#71717A", "$type": "color", "$description": "Secondary text, helper text, captions." },
      "700": { "$value": "#3F3F46", "$type": "color", "$description": "Body text." },
      "900": { "$value": "#18181B", "$type": "color", "$description": "Headings, primary text, max contrast." }
    },
    "state": {
      "success": { "$value": "#16A34A", "$type": "color", "$description": "Success badges, completion confirmations." },
      "warning": { "$value": "#F59E0B", "$type": "color", "$description": "Warning badges, attention required (amber chase indicator 7–14d)." },
      "error":   { "$value": "#DC2626", "$type": "color", "$description": "Error states, rejection badges, red chase indicator >14d." },
      "info":    { "$value": "#2563EB", "$type": "color", "$description": "Info banners, neutral notifications." }
    },
    "surface": {
      "page":           { "$value": "{color.neutral.50}",  "$type": "color", "$description": "Page background." },
      "card":           { "$value": "{color.neutral.0}",   "$type": "color", "$description": "Card / container background." },
      "card-elevated":  { "$value": "{color.neutral.0}",   "$type": "color", "$description": "Elevated card (with shadow.md)." },
      "input":          { "$value": "{color.neutral.0}",   "$type": "color", "$description": "Form input background." },
      "input-disabled": { "$value": "{color.neutral.100}", "$type": "color", "$description": "Disabled input." }
    },
    "text": {
      "primary":   { "$value": "{color.neutral.900}", "$type": "color", "$description": "Headings, body. AA contrast on surface.page." },
      "secondary": { "$value": "{color.neutral.700}", "$type": "color", "$description": "Body secondary. AA contrast." },
      "muted":     { "$value": "{color.neutral.500}", "$type": "color", "$description": "Helper text. AA contrast 4.5:1." },
      "disabled":  { "$value": "{color.neutral.400}", "$type": "color", "$description": "Disabled labels. Not interactive." },
      "inverse":   { "$value": "{color.neutral.0}",   "$type": "color", "$description": "Text on brand.red background." }
    },
    "border": {
      "default": { "$value": "{color.neutral.200}", "$type": "color" },
      "subtle":  { "$value": "{color.neutral.100}", "$type": "color" },
      "focus":   { "$value": "{color.brand.red}",   "$type": "color", "$description": "Focus ring colour — PAP red for visibility + brand consistency." },
      "error":   { "$value": "{color.state.error}", "$type": "color" }
    }
  },

  "spacing": {
    "0":  { "$value": "0px",  "$type": "dimension" },
    "1":  { "$value": "4px",  "$type": "dimension" },
    "2":  { "$value": "8px",  "$type": "dimension" },
    "3":  { "$value": "12px", "$type": "dimension" },
    "4":  { "$value": "16px", "$type": "dimension" },
    "6":  { "$value": "24px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "24": { "$value": "96px", "$type": "dimension" }
  },

  "radius": {
    "sm":   { "$value": "4px",    "$type": "dimension" },
    "md":   { "$value": "8px",    "$type": "dimension" },
    "lg":   { "$value": "12px",   "$type": "dimension" },
    "xl":   { "$value": "16px",   "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },

  "typography": {
    "family": {
      "sans": {
        "$value": "Inter, system-ui, -apple-system, BlinkMacSystemFont, sans-serif",
        "$type": "fontFamily",
        "$description": "Single typeface for entire system. No serifs Phase 1."
      }
    },
    "weight": {
      "regular":  { "$value": 400, "$type": "fontWeight" },
      "medium":   { "$value": 500, "$type": "fontWeight" },
      "semibold": { "$value": 600, "$type": "fontWeight" },
      "bold":     { "$value": 700, "$type": "fontWeight" }
    },
    "size": {
      "xs":   { "$value": "12px", "$type": "dimension", "$description": "Caption, legal." },
      "sm":   { "$value": "14px", "$type": "dimension", "$description": "Secondary text, dense tables." },
      "base": { "$value": "16px", "$type": "dimension", "$description": "Body. Minimum for mobile inputs (prevents iOS Safari zoom-on-focus)." },
      "lg":   { "$value": "18px", "$type": "dimension", "$description": "Lead, large body." },
      "xl":   { "$value": "20px", "$type": "dimension", "$description": "Subheadings." },
      "2xl":  { "$value": "24px", "$type": "dimension", "$description": "Section headings." },
      "3xl":  { "$value": "30px", "$type": "dimension", "$description": "Page titles." },
      "4xl":  { "$value": "36px", "$type": "dimension", "$description": "Landing headlines." }
    },
    "lineHeight": {
      "tight":   { "$value": 1.2, "$type": "number" },
      "snug":    { "$value": 1.4, "$type": "number" },
      "normal":  { "$value": 1.5, "$type": "number" },
      "relaxed": { "$value": 1.6, "$type": "number" }
    }
  },

  "shadow": {
    "sm": { "$value": "0 1px 2px 0 rgba(0,0,0,0.05)",   "$type": "shadow" },
    "md": { "$value": "0 4px 6px -1px rgba(0,0,0,0.07)", "$type": "shadow" },
    "lg": { "$value": "0 10px 15px -3px rgba(0,0,0,0.10)", "$type": "shadow" }
  },

  "breakpoint": {
    "sm":  { "$value": "640px",  "$type": "dimension" },
    "md":  { "$value": "768px",  "$type": "dimension" },
    "lg":  { "$value": "1024px", "$type": "dimension" },
    "xl":  { "$value": "1280px", "$type": "dimension" },
    "2xl": { "$value": "1536px", "$type": "dimension" }
  },

  "motion": {
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration", "$description": "Form field state changes, focus ring." },
      "base": { "$value": "200ms", "$type": "duration", "$description": "Dialog open, toast slide, dropdown reveal." },
      "slow": { "$value": "300ms", "$type": "duration", "$description": "Page transitions, drawer slide." }
    },
    "easing": {
      "enter":   { "$value": "cubic-bezier(0, 0, 0.2, 1)",    "$type": "cubicBezier", "$description": "Decelerating ease — for incoming elements." },
      "exit":    { "$value": "cubic-bezier(0.4, 0, 1, 1)",    "$type": "cubicBezier", "$description": "Accelerating ease — for outgoing elements." },
      "default": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier", "$description": "Smooth standard ease." }
    }
  },

  "zIndex": {
    "base":     { "$value": 0,  "$type": "number" },
    "elevated": { "$value": 10, "$type": "number", "$description": "Cards, dropdowns inline" },
    "sticky":   { "$value": 20, "$type": "number", "$description": "Sticky headers, sidebars" },
    "drawer":   { "$value": 40, "$type": "number", "$description": "Mobile drawer / sheet" },
    "dialog":   { "$value": 50, "$type": "number", "$description": "Modal dialogs" },
    "toast":    { "$value": 60, "$type": "number", "$description": "Toast/Sonner notifications" },
    "tooltip":  { "$value": 70, "$type": "number", "$description": "Tooltips, hover popovers" }
  }
}
